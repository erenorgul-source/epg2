# Settings for epg-playlist.service (installed to /etc/epg-playlist/epg.env)

# Branch that is pulled before every run (empty = the branch that was checked out at install time)
EPG_GIT_BRANCH=
# Set to 0 to stop updating the code (and the site scrapers) automatically
EPG_AUTO_UPDATE=1

EPG_PLAYLISTS=/etc/epg-playlist/playlists.txt
EPG_OVERRIDES=/etc/epg-playlist/overrides.channels.xml
EPG_DATA_DIR=/var/lib/epg-playlist

# Extra options for "npm run playlist:epg", see playlist-epg/README.md
EPG_ARGS="--days=3 --sources=4 --parallel=4 --maxConnections=2 --min-hours=12"

# Port of epg-playlist-serve.service
EPG_PORT=3000
